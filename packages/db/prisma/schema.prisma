// Mastermoshai data model. PostgreSQL + PostGIS.
// Money is stored as whole BDT integers. Every balance change is a LedgerEntry
// (double-entry), so the escrow can always be reconciled.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ───────────── Accounts ─────────────

enum Role {
  STUDENT
  GUARDIAN
  TEACHER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // login by OTP
  name      String
  email     String?  @unique
  role      Role
  photoUrl  String?
  createdAt DateTime @default(now())

  teacher        TeacherProfile?
  student        StudentProfile?
  children       StudentProfile[] @relation("GuardianChildren")
  devices        Device[]
  notifications  Notification[]
  wallet         Wallet?
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken String   @unique // Expo push token
  platform  String
  createdAt DateTime @default(now())
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model TeacherProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  university         String
  department         String
  bio                String
  introVideoUrl      String?
  verification       VerificationStatus @default(PENDING)
  documents          Json // student ID / certificate / NID upload keys
  subjects           String[]
  levels             String[]
  mediums            String[]
  teachesOnline      Boolean            @default(true)
  teachesOffline     Boolean            @default(false)
  areaName           String?
  // PostGIS point (SRID 4326). Searched with ST_DWithin.
  location           Unsupported("geography(Point,4326)")?
  travelRadiusKm     Float?
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  completedPaidClasses Int              @default(0) // drives the commission ladder
  suspendedUntil     DateTime?
  createdAt          DateTime           @default(now())

  slots       RoutineSlot[]
  enrollments Enrollment[]
  videos      Video[]
  strikes     Strike[]
  reviews     Review[]

  @@index([verification])
}

model StudentProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
  guardianId String?
  guardian   User?   @relation("GuardianChildren", fields: [guardianId], references: [id])
  level      String
  medium     String
  school     String?
  areaName   String?
  location   Unsupported("geography(Point,4326)")?

  enrollments Enrollment[]
  trials      TrialBooking[]
  flags       Flag[]
  reviews     Review[]
}

// ───────────── Routine & batches ─────────────

enum Mode {
  ONLINE
  OFFLINE
}

/// A recurring weekly batch the teacher offers (e.g. Sun/Tue/Thu 5 PM, 1:3, Physics, Class 9-10).
model RoutineSlot {
  id           String         @id @default(cuid())
  teacherId    String
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id])
  days         Int[] // 0=Sun … 6=Sat
  startTime    String // "HH:mm" Dhaka time
  durationMin  Int
  mode         Mode
  subjects     String[]
  level        String
  batchSize    Int // 1..5
  trialSeats   Int            @default(1)
  monthlyPrice Int // BDT per student
  active       Boolean        @default(true)

  enrollments Enrollment[]
  sessions    ClassSession[]
  trials      TrialBooking[]
}

model TrialBooking {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  slotId    String
  slot      RoutineSlot    @relation(fields: [slotId], references: [id])
  sessionId String
  session   ClassSession   @relation(fields: [sessionId], references: [id])
  outcome   String? // ENROLLED | NOT_INTERESTED | NO_SHOW
  createdAt DateTime       @default(now())

  @@unique([studentId, slotId]) // one free trial per student per batch
}

// ───────────── Enrollment, classes, attendance ─────────────

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A paid plan, e.g. 1 month = 12 classes for ৳6,000, held in escrow.
model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id])
  teacherId   String
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id])
  slotId      String
  slot        RoutineSlot      @relation(fields: [slotId], references: [id])
  status      EnrollmentStatus @default(PENDING_PAYMENT)
  totalAmount Int
  classCount  Int
  startsOn    DateTime
  cancelledAt DateTime?
  cancelledBy String?
  createdAt   DateTime         @default(now())

  payment     Payment?
  attendances SessionAttendance[]
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// One meeting of a batch. Online sessions map 1:1 to a LiveKit room.
model ClassSession {
  id             String        @id @default(cuid())
  slotId         String
  slot           RoutineSlot   @relation(fields: [slotId], references: [id])
  scheduledStart DateTime
  durationMin    Int
  status         SessionStatus @default(SCHEDULED)
  roomName       String?       @unique // LiveKit room
  startedAt      DateTime?
  endedAt        DateTime?
  offlineCode    String? // 4-digit code student shows teacher for offline check-in

  presence    PresenceEvent[]
  attendances SessionAttendance[]
  trials      TrialBooking[]

  @@index([scheduledStart])
}

/// Raw join/leave log from LiveKit webhooks or offline check-in. Evidence for disputes.
model PresenceEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])
  userId    String
  kind      String // JOIN | LEAVE | OFFLINE_CHECKIN
  at        DateTime
  lat       Float?
  lng       Float?

  @@index([sessionId, userId])
}

enum SettlementState {
  HELD // in escrow, flag window open
  RELEASED // paid to teacher wallet / refunded
  DISPUTED // flag open
}

/// One student's share of one class: the unit of escrow, payout and refund.
model SessionAttendance {
  id            String          @id @default(cuid())
  sessionId     String
  session       ClassSession    @relation(fields: [sessionId], references: [id])
  enrollmentId  String
  enrollment    Enrollment      @relation(fields: [enrollmentId], references: [id])
  classShare    Int
  outcome       String? // SessionOutcome from @mastermoshai/core
  state         SettlementState @default(HELD)
  releaseAt     DateTime?
  teacherNet    Int?
  platformFee   Int?
  refund        Int?
  settledAt     DateTime?

  flag Flag?

  @@unique([sessionId, enrollmentId])
}

// ───────────── Flags, reviews, strikes ─────────────

enum FlagReason {
  TEACHER_ABSENT
  TEACHER_LATE
  ENDED_EARLY
  POOR_TEACHING
  BEHAVIOUR
  OTHER
}

enum FlagStatus {
  OPEN
  AUTO_RESOLVED
  UNDER_REVIEW
  UPHELD
  PARTLY_UPHELD
  REJECTED
}

model Flag {
  id           String            @id @default(cuid())
  attendanceId String            @unique
  attendance   SessionAttendance @relation(fields: [attendanceId], references: [id])
  studentId    String
  student      StudentProfile    @relation(fields: [studentId], references: [id])
  reason       FlagReason
  details      String
  status       FlagStatus        @default(OPEN)
  ruling       Float? // 0 | 0.5 | 1 share the teacher keeps
  adminNote    String?
  decidedById  String?
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?
}

model Strike {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  reason    String
  at        DateTime       @default(now())
}

model Review {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  rating    Int
  text      String?
  createdAt DateTime       @default(now())

  @@unique([teacherId, studentId])
}

// ───────────── Money ─────────────

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id           String        @id @default(cuid())
  enrollmentId String        @unique
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  amount       Int
  gateway      String // SSLCOMMERZ | BKASH | NAGAD
  gatewayTxnId String?       @unique
  status       PaymentStatus @default(INITIATED)
  createdAt    DateTime      @default(now())
}

enum WalletKind {
  STUDENT_CREDIT
  TEACHER_EARNINGS
}

model Wallet {
  id      String     @id @default(cuid())
  userId  String     @unique
  user    User       @relation(fields: [userId], references: [id])
  kind    WalletKind
  balance Int        @default(0) // cached; source of truth is LedgerEntry
}

/// Double-entry ledger. Accounts: escrow, platform_revenue, wallet:<id>, gateway, payout.
model LedgerEntry {
  id          String   @id @default(cuid())
  txnId       String // groups the debit and credit legs
  account     String
  amount      Int // positive = credit, negative = debit; each txn sums to 0
  kind        String // PAYMENT_IN | CLASS_RELEASE | COMMISSION | REFUND | PAYOUT
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())

  @@index([account])
  @@index([txnId])
}

model Payout {
  id        String   @id @default(cuid())
  teacherId String
  amount    Int
  method    String // BKASH | BANK
  account   String
  status    String   @default("REQUESTED") // REQUESTED | PAID | FAILED
  createdAt DateTime @default(now())
  paidAt    DateTime?
}

// ───────────── Content & notifications ─────────────

model Video {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  title       String
  description String?
  subject     String
  level       String
  streamId    String // Bunny Stream / Cloudflare Stream id
  durationSec Int
  views       Int            @default(0)
  published   Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@index([subject, level])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // CLASS_REMINDER | CLASS_STARTED | PAYMENT | FLAG_UPDATE | PAYOUT
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ═════════════ Content module (from packages/content/prisma/content.prisma) ═════════════

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentOwner {
  PLATFORM // made by Mastermoshai, free for every verified teacher
  TEACHER  // a teacher's own upload or edited copy
}

enum QuestionType {
  MCQ          // single correct option
  MULTI_MCQ    // multiple-statement (i, ii, iii) style, still one answer key
  CQ           // creative question: stem + a/b/c/d parts
  SHORT
  WRITTEN      // BCS written / essay
  FILL_BLANK
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamMode {
  LIVE       // fixed window, everyone at once
  PRACTICE   // any time within window, can retake
  HOMEWORK   // printable / written, teacher grades
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

// ── Curriculum tree ──────────────────────────────────────────────────────────

model CurriculumSegment {
  id      String  @id @default(cuid())
  code    String  @unique // PRE_PRIMARY, PRIMARY, ... (see taxonomy.ts)
  nameBn  String
  nameEn  String
  order   Int
  tracks  CurriculumTrack[]
}

model CurriculumTrack {
  id         String  @id @default(cuid())
  code       String  @unique // CLASS_9, HSC_1ST, ADM_MEDICAL, JOB_BCS_PRELI ...
  nameBn     String
  nameEn     String
  order      Int
  targetExam String?
  segmentId  String
  segment    CurriculumSegment @relation(fields: [segmentId], references: [id])
  subjects   TrackSubject[]
}

model Subject {
  id      String  @id @default(cuid())
  code    String  @unique // PHYSICS, HIGHER_MATH_1, BD_AFFAIRS ...
  nameBn  String
  nameEn  String
  tracks  TrackSubject[]
  chapters Chapter[]
}

/// A subject as taught at one track (Physics @ CLASS_9 differs from Physics @ ADM_ENGINEERING).
model TrackSubject {
  id        String  @id @default(cuid())
  trackId   String
  subjectId String
  stream    String? // SCIENCE | BUSINESS | HUMANITIES | null = all
  track     CurriculumTrack @relation(fields: [trackId], references: [id])
  subject   Subject         @relation(fields: [subjectId], references: [id])
  chapters  Chapter[]

  @@unique([trackId, subjectId])
}

model Chapter {
  id             String  @id @default(cuid())
  trackSubjectId String
  subjectId      String
  number         Int
  titleBn        String
  titleEn        String?
  trackSubject   TrackSubject @relation(fields: [trackSubjectId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  topics         Topic[]

  @@unique([trackSubjectId, number])
}

model Topic {
  id         String  @id @default(cuid())
  chapterId  String
  order      Int
  titleBn    String
  titleEn    String?
  /// Suggested class time in minutes, used by lesson plans and routine builder.
  minutes    Int     @default(60)
  chapter    Chapter @relation(fields: [chapterId], references: [id])
  sheets     LectureSheet[]
  decks      SlideDeck[]
  questions  QuestionTopic[]

  @@unique([chapterId, order])
}

// ── Teaching material ────────────────────────────────────────────────────────

model LectureSheet {
  id         String        @id @default(cuid())
  topicId    String
  owner      ContentOwner  @default(PLATFORM)
  authorId   String?       // User.id; null for platform sheets
  /// Copy-on-edit: a teacher's personal version points at the platform original.
  forkedFromId String?
  medium     String        @default("BANGLA") // BANGLA | ENGLISH_VERSION
  title      String
  /// Structured blocks (see lecture-sheet.ts LectureSheetBody). Rendered to web, PDF and slides.
  body       Json
  version    Int           @default(1)
  status     ContentStatus @default(DRAFT)
  reviewedBy String?
  publishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  topic      Topic         @relation(fields: [topicId], references: [id])
  forkedFrom LectureSheet? @relation("SheetFork", fields: [forkedFromId], references: [id])
  forks      LectureSheet[] @relation("SheetFork")

  @@index([topicId, owner, status])
}

model SlideDeck {
  id        String        @id @default(cuid())
  topicId   String
  owner     ContentOwner  @default(PLATFORM)
  authorId  String?
  sheetId   String?       // generated from this sheet
  title     String
  slides    Json          // Slide[] (see slides.ts)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  topic     Topic         @relation(fields: [topicId], references: [id])

  @@index([topicId, owner, status])
}

// ── Question bank ────────────────────────────────────────────────────────────

model Question {
  id          String        @id @default(cuid())
  type        QuestionType
  difficulty  Difficulty    @default(MEDIUM)
  owner       ContentOwner  @default(PLATFORM)
  authorId    String?
  medium      String        @default("BANGLA")
  /// Stem, options, parts, answer key, explanation (see questions.ts QuestionBody).
  body        Json
  marks       Float         @default(1)
  /// e.g. "Dhaka Board 2023", "47th BCS", "DU Ka 2022-23"; null = original.
  sourceTag   String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  topics      QuestionTopic[]
  examItems   ExamItem[]

  @@index([type, difficulty, status])
}

model QuestionTopic {
  questionId String
  topicId    String
  question   Question @relation(fields: [questionId], references: [id])
  topic      Topic    @relation(fields: [topicId], references: [id])

  @@id([questionId, topicId])
  @@index([topicId])
}

// ── Exams ────────────────────────────────────────────────────────────────────

/// A built exam paper. Teachers get one by one-click generate (or by copying a platform paper).
model Exam {
  id          String        @id @default(cuid())
  owner       ContentOwner  @default(TEACHER)
  authorId    String?       // TeacherProfile.userId
  title       String
  trackCode   String
  subjectCode String?
  topicIds    String[]
  /// The blueprint used to generate (counts by type/difficulty), kept for "regenerate".
  blueprint   Json
  durationMin Int
  totalMarks  Float
  negativeMark Float        @default(0) // per wrong MCQ, e.g. 0.25
  shuffle     Boolean       @default(true)
  seed        Int
  createdAt   DateTime      @default(now())
  items       ExamItem[]
  assignments ExamAssignment[]
}

model ExamItem {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  order      Int
  marks      Float
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([examId, order])
}

/// Sends an exam to a teacher's batch (RoutineSlot) or a single student.
model ExamAssignment {
  id          String    @id @default(cuid())
  examId      String
  teacherId   String    // TeacherProfile.id
  slotId      String?   // RoutineSlot.id, students resolved via Enrollment ACTIVE
  studentId   String?   // StudentProfile.id for 1:1 assignment
  mode        ExamMode  @default(PRACTICE)
  opensAt     DateTime
  closesAt    DateTime
  showAnswersAfterClose Boolean @default(true)
  createdAt   DateTime  @default(now())
  exam        Exam      @relation(fields: [examId], references: [id])
  attempts    ExamAttempt[]

  @@index([slotId])
  @@index([studentId])
}

model ExamAttempt {
  id           String        @id @default(cuid())
  assignmentId String
  studentId    String        // StudentProfile.id
  status       AttemptStatus @default(IN_PROGRESS)
  /// questionId -> answer (option index, text, or per-part text for CQ)
  answers      Json          @default("{}")
  /// questionId -> { marks, correct, feedback }
  grading      Json?
  score        Float?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  gradedAt     DateTime?
  assignment   ExamAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, studentId])
}

// Core models need no new columns. Relations are by id string so the content
// module can ship without touching User/TeacherProfile/StudentProfile/RoutineSlot.
