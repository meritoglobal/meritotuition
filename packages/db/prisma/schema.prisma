// Porao data model. PostgreSQL + PostGIS.
// Money is stored as whole BDT integers. Every balance change is a LedgerEntry
// (double-entry), so the escrow can always be reconciled.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ───────────── Accounts ─────────────

enum Role {
  STUDENT
  GUARDIAN
  TEACHER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // login by OTP
  name      String
  email     String?  @unique
  role      Role
  photoUrl  String?
  createdAt DateTime @default(now())

  teacher        TeacherProfile?
  student        StudentProfile?
  children       StudentProfile[] @relation("GuardianChildren")
  devices        Device[]
  notifications  Notification[]
  wallet         Wallet?
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken String   @unique // Expo push token
  platform  String
  createdAt DateTime @default(now())
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model TeacherProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  university         String
  department         String
  bio                String
  introVideoUrl      String?
  verification       VerificationStatus @default(PENDING)
  documents          Json // student ID / certificate / NID upload keys
  subjects           String[]
  levels             String[]
  mediums            String[]
  teachesOnline      Boolean            @default(true)
  teachesOffline     Boolean            @default(false)
  areaName           String?
  // PostGIS point (SRID 4326). Searched with ST_DWithin.
  location           Unsupported("geography(Point,4326)")?
  travelRadiusKm     Float?
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  completedPaidClasses Int              @default(0) // drives the commission ladder
  suspendedUntil     DateTime?
  createdAt          DateTime           @default(now())

  slots       RoutineSlot[]
  enrollments Enrollment[]
  videos      Video[]
  strikes     Strike[]
  reviews     Review[]

  @@index([verification])
}

model StudentProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
  guardianId String?
  guardian   User?   @relation("GuardianChildren", fields: [guardianId], references: [id])
  level      String
  medium     String
  school     String?
  areaName   String?
  location   Unsupported("geography(Point,4326)")?

  enrollments Enrollment[]
  trials      TrialBooking[]
  flags       Flag[]
  reviews     Review[]
}

// ───────────── Routine & batches ─────────────

enum Mode {
  ONLINE
  OFFLINE
}

/// A recurring weekly batch the teacher offers (e.g. Sun/Tue/Thu 5 PM, 1:3, Physics, Class 9-10).
model RoutineSlot {
  id           String         @id @default(cuid())
  teacherId    String
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id])
  days         Int[] // 0=Sun … 6=Sat
  startTime    String // "HH:mm" Dhaka time
  durationMin  Int
  mode         Mode
  subjects     String[]
  level        String
  batchSize    Int // 1..5
  trialSeats   Int            @default(1)
  monthlyPrice Int // BDT per student
  active       Boolean        @default(true)

  enrollments Enrollment[]
  sessions    ClassSession[]
  trials      TrialBooking[]
}

model TrialBooking {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  slotId    String
  slot      RoutineSlot    @relation(fields: [slotId], references: [id])
  sessionId String
  session   ClassSession   @relation(fields: [sessionId], references: [id])
  outcome   String? // ENROLLED | NOT_INTERESTED | NO_SHOW
  createdAt DateTime       @default(now())

  @@unique([studentId, slotId]) // one free trial per student per batch
}

// ───────────── Enrollment, classes, attendance ─────────────

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A paid plan, e.g. 1 month = 12 classes for ৳6,000, held in escrow.
model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id])
  teacherId   String
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id])
  slotId      String
  slot        RoutineSlot      @relation(fields: [slotId], references: [id])
  status      EnrollmentStatus @default(PENDING_PAYMENT)
  totalAmount Int
  classCount  Int
  startsOn    DateTime
  cancelledAt DateTime?
  cancelledBy String?
  createdAt   DateTime         @default(now())

  payment     Payment?
  attendances SessionAttendance[]
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// One meeting of a batch. Online sessions map 1:1 to a LiveKit room.
model ClassSession {
  id             String        @id @default(cuid())
  slotId         String
  slot           RoutineSlot   @relation(fields: [slotId], references: [id])
  scheduledStart DateTime
  durationMin    Int
  status         SessionStatus @default(SCHEDULED)
  roomName       String?       @unique // LiveKit room
  startedAt      DateTime?
  endedAt        DateTime?
  offlineCode    String? // 4-digit code student shows teacher for offline check-in

  presence    PresenceEvent[]
  attendances SessionAttendance[]
  trials      TrialBooking[]

  @@index([scheduledStart])
}

/// Raw join/leave log from LiveKit webhooks or offline check-in. Evidence for disputes.
model PresenceEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])
  userId    String
  kind      String // JOIN | LEAVE | OFFLINE_CHECKIN
  at        DateTime
  lat       Float?
  lng       Float?

  @@index([sessionId, userId])
}

enum SettlementState {
  HELD // in escrow, flag window open
  RELEASED // paid to teacher wallet / refunded
  DISPUTED // flag open
}

/// One student's share of one class: the unit of escrow, payout and refund.
model SessionAttendance {
  id            String          @id @default(cuid())
  sessionId     String
  session       ClassSession    @relation(fields: [sessionId], references: [id])
  enrollmentId  String
  enrollment    Enrollment      @relation(fields: [enrollmentId], references: [id])
  classShare    Int
  outcome       String? // SessionOutcome from @porao/core
  state         SettlementState @default(HELD)
  releaseAt     DateTime?
  teacherNet    Int?
  platformFee   Int?
  refund        Int?
  settledAt     DateTime?

  flag Flag?

  @@unique([sessionId, enrollmentId])
}

// ───────────── Flags, reviews, strikes ─────────────

enum FlagReason {
  TEACHER_ABSENT
  TEACHER_LATE
  ENDED_EARLY
  POOR_TEACHING
  BEHAVIOUR
  OTHER
}

enum FlagStatus {
  OPEN
  AUTO_RESOLVED
  UNDER_REVIEW
  UPHELD
  PARTLY_UPHELD
  REJECTED
}

model Flag {
  id           String            @id @default(cuid())
  attendanceId String            @unique
  attendance   SessionAttendance @relation(fields: [attendanceId], references: [id])
  studentId    String
  student      StudentProfile    @relation(fields: [studentId], references: [id])
  reason       FlagReason
  details      String
  status       FlagStatus        @default(OPEN)
  ruling       Float? // 0 | 0.5 | 1 share the teacher keeps
  adminNote    String?
  decidedById  String?
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?
}

model Strike {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  reason    String
  at        DateTime       @default(now())
}

model Review {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  rating    Int
  text      String?
  createdAt DateTime       @default(now())

  @@unique([teacherId, studentId])
}

// ───────────── Money ─────────────

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id           String        @id @default(cuid())
  enrollmentId String        @unique
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  amount       Int
  gateway      String // SSLCOMMERZ | BKASH | NAGAD
  gatewayTxnId String?       @unique
  status       PaymentStatus @default(INITIATED)
  createdAt    DateTime      @default(now())
}

enum WalletKind {
  STUDENT_CREDIT
  TEACHER_EARNINGS
}

model Wallet {
  id      String     @id @default(cuid())
  userId  String     @unique
  user    User       @relation(fields: [userId], references: [id])
  kind    WalletKind
  balance Int        @default(0) // cached; source of truth is LedgerEntry
}

/// Double-entry ledger. Accounts: escrow, platform_revenue, wallet:<id>, gateway, payout.
model LedgerEntry {
  id          String   @id @default(cuid())
  txnId       String // groups the debit and credit legs
  account     String
  amount      Int // positive = credit, negative = debit; each txn sums to 0
  kind        String // PAYMENT_IN | CLASS_RELEASE | COMMISSION | REFUND | PAYOUT
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())

  @@index([account])
  @@index([txnId])
}

model Payout {
  id        String   @id @default(cuid())
  teacherId String
  amount    Int
  method    String // BKASH | BANK
  account   String
  status    String   @default("REQUESTED") // REQUESTED | PAID | FAILED
  createdAt DateTime @default(now())
  paidAt    DateTime?
}

// ───────────── Content & notifications ─────────────

model Video {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  title       String
  description String?
  subject     String
  level       String
  streamId    String // Bunny Stream / Cloudflare Stream id
  durationSec Int
  views       Int            @default(0)
  published   Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@index([subject, level])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // CLASS_REMINDER | CLASS_STARTED | PAYMENT | FLAG_UPDATE | PAYOUT
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
